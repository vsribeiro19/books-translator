# Template de segredos do projeto.
# PASSO 1: copie para secrets.env  (cp examples/secrets.env.example config... )
# Ex.:   cp config/secrets.env.example config/secrets.env
# PASSO 2: preencha os valores reais no arquivo config/secrets.env.
# PASSO 3: NUNCA commite config/secrets.env (está no .gitignore).

# O loader automático injeta as variáveis abaixo no ambiente no startup.
# Variáveis já exportadas manualmente no shell têm prioridade.

# Chave de API do provedor LLM usado por padrão (DeepSeek via OpenCode Zen).
LLM_DEEPSEEK_API_KEY=

# Fallback genérico: usado se o provider não definir api_key_env.
LLM_API_KEY=